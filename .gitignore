# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
env/
venv/
ENV/

# IDE files
.idea/
.vscode/
*.swp
*.swo

# Data directories (raw datasets and heavy intermediates should not be committed to Git)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Sensitive and temporary files
.env
.DS_Store
*.log

# Large model artifacts if exceeding GitHub limit
artifacts/models/*.joblib
!artifacts/models/.gitkeep

# Test & coverage
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
